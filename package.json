{
  "name": "station-platform",
  "version": "0.0.0",
  "private": true,
  "description": "STATION — multi-robot greenhouse control platform (monorepo)",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
