{
  "name": "@station/contracts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./runtime/index.ts",
    "./schema/*": "./schema/*"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "echo \"(contracts) no lint\" && exit 0",
    "codegen": "node scripts/codegen.mjs && node scripts/build-verb-registry.mjs",
    "verbs": "node scripts/build-verb-registry.mjs",
    "validate": "node scripts/validate.mjs"
  },
  "devDependencies": {
    "@station/tsconfig": "workspace:*",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "json-schema-to-typescript": "^15.0.3",
    "typescript": "^5.7.2"
  }
}
