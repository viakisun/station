      "fields": [{ "name": "speed", "offset": 0, "type": "i16", "scale": 0.001, "unit": "m/s" }] },
    { "channel": "machine.power.battery_voltage", "frameId": "0x18FF5002", "dlc": 8,
      "fields": [{ "name": "voltage", "offset": 0, "type": "u16", "scale": 0.001, "unit": "V" }] },
    { "channel": "machine.safety.estop", "frameId": "0x18FF5003", "dlc": 8,
      "fields": [{ "name": "estop", "offset": 0, "type": "bool" }] }
